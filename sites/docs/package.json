{
  "name": "discussionbridge-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-content": "node ../../scripts/sync-docs-site-content.mjs",
    "refresh-metadata": "node ../../scripts/sync-docs-site-content.mjs --refresh-metadata",
    "check:attribution": "node ../../scripts/check-attribution.mjs --docs-scope",
    "check:metadata": "node --test test/docs-page-metadata.test.mjs",
    "predev": "npm run sync-content",
    "dev": "astro dev",
    "prebuild": "npm run check:metadata && npm run sync-content && npm run check:attribution",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.2",
    "astro": "^7.0.4"
  }
}
