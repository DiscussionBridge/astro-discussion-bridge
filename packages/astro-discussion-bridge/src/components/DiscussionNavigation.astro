---
import {
  activeNavigationBranch,
  parseNavigationManifest,
  type DiscussionNavigationManifest,
} from "astro-discussion-bridge";
import DiscussionNavigationBranch from "./DiscussionNavigationBranch.astro";

interface Props {
  class?: string;
  currentUrl?: string;
  manifest: DiscussionNavigationManifest;
}

const manifest = parseNavigationManifest(Astro.props.manifest);
const currentUrl = Astro.props.currentUrl ?? Astro.url.href;
const activeIds = activeNavigationBranch(manifest, currentUrl);
const activeLens = activeIds[0];
const className = ["discussion-bridge-navigation", Astro.props.class].filter(Boolean).join(" ");
---

<nav class={className} aria-label="Content navigation">
  {manifest.lenses.map((lens) => (
    <details class="discussion-bridge-navigation-lens" open={lens.key === activeLens}>
      <summary>{lens.label}</summary>
      <ul>
        {lens.nodes.map((node) => (
          <DiscussionNavigationBranch node={node} activeIds={activeIds.slice(1)} />
        ))}
      </ul>
    </details>
  ))}
</nav>

<style>
  .discussion-bridge-navigation {
    font-size: 0.9375rem;
  }

  .discussion-bridge-navigation :global(ul) {
    margin: 0.35rem 0 0;
    padding-inline-start: 1rem;
    list-style: none;
  }

  .discussion-bridge-navigation :global(li) {
    margin-block: 0.3rem;
  }

  .discussion-bridge-navigation :global(summary) {
    cursor: pointer;
    font-weight: 650;
  }

  .discussion-bridge-navigation :global(a[aria-current="page"]) {
    font-weight: 700;
    text-decoration-thickness: 0.14em;
  }

  .discussion-bridge-navigation-lens + .discussion-bridge-navigation-lens {
    margin-block-start: 0.5rem;
  }
</style>
