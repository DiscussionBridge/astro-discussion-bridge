---
import config from "virtual:discussion-bridge/config";
import { createDiscourseClient, type DiscoursePost } from "astro-discussion-bridge/client";

interface Props {
  topicId?: number | string;
  minScore?: number;
  maxReplies?: number;
  discourseUrl?: string;
  heading?: string;
  refreshOnPageLoad?: boolean;
  renderMermaid?: boolean;
  showLikes?: boolean;
  class?: string;
  topicUrl?: string;
}

const topicId = Astro.props.topicId ?? Astro.props.frontmatter?.discourseTopicId;
const minScore = Astro.props.minScore ?? config.replies.minScore;
const maxReplies = Astro.props.maxReplies ?? config.replies.maxReplies;
const discourseUrl = Astro.props.discourseUrl ?? config.discourseUrl;
const heading = Astro.props.heading ?? "Discussion";
const refreshOnPageLoad = Astro.props.refreshOnPageLoad ?? config.replies.refreshOnPageLoad;
const renderMermaid = Astro.props.renderMermaid ?? config.replies.renderMermaid;
const showLikes = Astro.props.showLikes ?? config.replies.showLikes;
const topicUrl = Astro.props.topicUrl ?? Astro.props.frontmatter?.discourseTopicUrl;
let replies: DiscoursePost[] = [];
let repliesUnavailable = false;

if (config.replies.enabled && topicId) {
  const discourse = createDiscourseClient({ discourseUrl });
  try {
    const topic = await discourse.topic(topicId);
    replies = topic.post_stream.posts
      .filter((post) => post.post_number > 1)
      .filter((post) => post.score >= minScore)
      .slice(0, maxReplies);
  } catch {
    repliesUnavailable = true;
  }
}

function likeCount(post: DiscoursePost): number {
  const likeAction = post.actions_summary?.find((action) => action.id === 2);
  return post.like_count ?? likeAction?.count ?? 0;
}

function reactionItems(post: DiscoursePost): Array<{ icon: string; label: string; count: number }> {
  if (post.reactions?.length) {
    return post.reactions.map((reaction) => ({
      icon: reactionIconName(reaction.id),
      label: reactionLabel(reaction.id),
      count: reaction.count,
    }));
  }

  const count = likeCount(post);
  return count > 0 ? [{ icon: "heart", label: "likes", count }] : [];
}

function reactionIconName(id: string): string {
  const icons: Record<string, string> = {
    "+1": "thumbs-up",
    clap: "clap",
    confetti_ball: "confetti",
    heart: "heart",
    hugs: "hugs",
    laughing: "laughing",
    open_mouth: "surprise",
  };
  return icons[id] ?? id;
}

function reactionLabel(id: string): string {
  const labels: Record<string, string> = {
    "+1": "thumbs up",
    clap: "claps",
    confetti_ball: "celebrations",
    heart: "likes",
    hugs: "hugs",
    laughing: "laughs",
    open_mouth: "surprises",
  };
  return labels[id] ?? id;
}

function replyUrl(post: DiscoursePost): string {
  return `${discourseUrl}/t/${post.topic_slug}/${post.topic_id}/${post.post_number}`;
}

function userUrl(post: DiscoursePost): string {
  return `${discourseUrl}/u/${encodeURIComponent(post.username.toLowerCase())}`;
}

function replyRecipientUrl(post: DiscoursePost): string | undefined {
  if (!post.reply_to_user) return undefined;
  return `${discourseUrl}/u/${encodeURIComponent(post.reply_to_user.username.toLowerCase())}`;
}

function avatarUrl(post: DiscoursePost): string | undefined {
  if (!post.avatar_template) return undefined;
  const template = post.avatar_template.replace("{size}", "48");
  if (/^https?:\/\//.test(template)) return template;
  return `${discourseUrl}${template.startsWith("/") ? "" : "/"}${template}`;
}

function cookedHtml(post: DiscoursePost): string {
  return absolutizeDiscourseLinks(post.cooked, discourseUrl);
}

function absolutizeDiscourseLinks(html: string, baseUrl: string): string {
  const normalizedBase = baseUrl.replace(/\/+$/, "");
  return html.replace(/\s(href|src)="\/(?!\/)([^"]*)"/g, ` $1="${normalizedBase}/$2"`);
}

function actionItems(post: DiscoursePost): Array<{ icon: string; label: string; count: number }> {
  if (!showLikes) return [];
  return [
    ...reactionItems(post),
    ...(post.reply_count > 0 ? [{ icon: "reply", label: "replies", count: post.reply_count }] : []),
    ...(post.quote_count > 0 ? [{ icon: "quote", label: "quotes", count: post.quote_count }] : []),
  ];
}

function iconMarkup(name: string): string {
  const icons: Record<string, string> = {
    heart: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>`,
    "thumbs-up": `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3m0 11V10l5-8a3 3 0 0 1 3 3v4h4.2a2 2 0 0 1 2 2.3l-1.4 8a2 2 0 0 1-2 1.7H7Z"/></svg>`,
    reply: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 17-5-5 5-5"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>`,
    quote: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11H4a6 6 0 0 1 6-6v2a4 4 0 0 0-4 4h2v6H4v-6Zm12 0h-4a6 6 0 0 1 6-6v2a4 4 0 0 0-4 4h2v6h-4v-6Z"/></svg>`,
    clap: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 13 4-9a2 2 0 0 1 3.7 1.5L13 12"/><path d="m11 14 5-8a2 2 0 0 1 3.5 1.9L15 16"/><path d="M5 12.5V5a2 2 0 0 1 4 0v7"/><path d="M5 12.5 3.6 9.8A2 2 0 1 0 .1 11.7L4.5 20A4 4 0 0 0 8 22h6a5 5 0 0 0 5-5v-1"/></svg>`,
    confetti: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 20 5-14 9 9-14 5Z"/><path d="M14 4h.01"/><path d="M20 9h.01"/><path d="M16 2l1 2"/><path d="M21 5l-2 1"/></svg>`,
    hugs: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11a4 4 0 1 1 8 0"/><path d="M4 21v-2a6 6 0 0 1 12 0v2"/><path d="M16 14c2.2.5 4 2.4 4 5v2"/></svg>`,
    laughing: `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 9h.01"/><path d="M16 9h.01"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/></svg>`,
    surprise: `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 9h.01"/><path d="M16 9h.01"/><circle cx="12" cy="15" r="2"/></svg>`,
  };
  return icons[name] ?? `<span class="discussion-bridge-reply__action-text">${name}</span>`;
}

const refreshConfig = topicId
  ? {
      discourseUrl,
      maxReplies,
      minScore,
      refreshEndpoint: config.replies.refreshEndpoint,
      renderMermaid,
      showLikes,
      topicId: String(topicId),
    }
  : undefined;
---

{config.replies.enabled && topicId && (
  <section
    class:list={["discussion-bridge-replies", Astro.props.class]}
    data-discussion-bridge-replies
    data-refresh={refreshOnPageLoad ? "true" : "false"}
    data-render-mermaid={renderMermaid ? "true" : "false"}
    data-refresh-config={refreshConfig ? JSON.stringify(refreshConfig) : undefined}
  >
    <div class="discussion-bridge-replies__header">
      <h2>{heading}</h2>
      {topicUrl && <a href={topicUrl}>Open full discussion</a>}
    </div>
    <ol data-discussion-bridge-replies-list>
      {replies.length > 0 ? (
        replies.map((reply) => (
          <li>
            <article>
              <div class="discussion-bridge-reply__avatar" aria-hidden="true">
                {avatarUrl(reply) ? (
                  <img src={avatarUrl(reply)} alt="" loading="lazy" />
                ) : (
                  <span>{(reply.display_username ?? reply.username).slice(0, 1).toUpperCase()}</span>
                )}
              </div>
              <div class="discussion-bridge-reply__content">
                <header class="discussion-bridge-reply__header">
                  <div class="discussion-bridge-reply__identity">
                    <a class="discussion-bridge-reply__author" href={userUrl(reply)}>
                      {reply.display_username ?? reply.username}
                    </a>
                    {reply.reply_to_user && (
                      <span class="discussion-bridge-reply__reply-to">
                        replying to <a href={replyRecipientUrl(reply)}>@{reply.reply_to_user.username}</a>
                      </span>
                    )}
                  </div>
                  <a class="discussion-bridge-reply__permalink" href={replyUrl(reply)}>
                    <time datetime={reply.created_at}>{new Date(reply.created_at).toLocaleDateString()}</time>
                  </a>
                </header>
                <div class="discussion-bridge-reply__body" set:html={cookedHtml(reply)} />
                {actionItems(reply).length > 0 && (
                  <ul class="discussion-bridge-reply__actions" aria-label="Post actions">
                    {actionItems(reply).map((action) => (
                      <li aria-label={`${action.count} ${action.label}`}>
                        <span class="discussion-bridge-reply__action-icon" set:html={iconMarkup(action.icon)} />
                        <span>{action.count}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          </li>
        ))
      ) : repliesUnavailable ? (
        <li data-discussion-bridge-unavailable>
          The discussion is temporarily unavailable.
          {topicUrl && <a href={topicUrl}>Open the full discussion</a>}
        </li>
      ) : (
        <li data-discussion-bridge-empty>Loading discussion...</li>
      )}
    </ol>
  </section>
)}

{config.replies.enabled && topicId && (
  <script>
    let mermaidReady;
    const containers = document.querySelectorAll("[data-discussion-bridge-replies]");

    for (const container of containers) {
      if (container.getAttribute("data-discussion-bridge-initialized") === "true") continue;
      container.setAttribute("data-discussion-bridge-initialized", "true");

      const configValue = container.getAttribute("data-refresh-config");
      const list = container.querySelector("[data-discussion-bridge-replies-list]");
      if (!configValue || !list) continue;

      const refreshConfig = JSON.parse(configValue);

      if (container.getAttribute("data-refresh") === "true") {
        try {
          const topicUrl = refreshConfig.refreshEndpoint
            ? refreshConfig.refreshEndpoint.replace("{topicId}", encodeURIComponent(refreshConfig.topicId))
            : `${refreshConfig.discourseUrl}/t/${refreshConfig.topicId}.json`;
          const response = await fetch(topicUrl, { headers: { Accept: "application/json" } });
          if (response.ok) {
            const topic = await response.json();
            const replies = topic.post_stream.posts
              .filter((post) => post.post_number > 1)
              .filter((post) => post.score >= refreshConfig.minScore)
              .slice(0, refreshConfig.maxReplies);

            list.replaceChildren(...replies.map((reply) => renderReply(reply, refreshConfig)));
          }
        } catch {
          // Keep the server-rendered fallback if the live refresh is unavailable.
        }
      }

      if (container.getAttribute("data-render-mermaid") === "true") {
        await renderMermaidBlocks(list);
      }
    }

    async function renderMermaidBlocks(container) {
      const blocks = container.querySelectorAll(
        "pre code.language-mermaid, pre code.lang-mermaid, code.language-mermaid, code.lang-mermaid",
      );
      if (blocks.length === 0) return;

      let mermaid;
      try {
        mermaidReady ??= import("mermaid").then((module) => {
          module.default.initialize({ startOnLoad: false, securityLevel: "strict" });
          return module.default;
        });
        mermaid = await mermaidReady;
      } catch (error) {
        console.error("[DiscussionBridge] Mermaid renderer failed to load", error);
        mermaidReady = undefined;
        return;
      }

      for (const block of blocks) {
        const source = block.textContent?.trim();
        if (!source) continue;

        const wrapper = document.createElement("div");
        const id = `discussion-bridge-mermaid-${
          crypto.randomUUID?.() ?? Math.random().toString(36).slice(2)
        }`;
        wrapper.className = "discussion-bridge-reply__mermaid";

        try {
          const { svg } = await mermaid.render(id, source);
          wrapper.innerHTML = svg;
          (block.closest("pre") ?? block).replaceWith(wrapper);
        } catch (error) {
          console.error("[DiscussionBridge] Mermaid reply render failed", error);
        }
      }
    }

    function renderReply(reply, refreshConfig) {
      const item = document.createElement("li");
      const article = document.createElement("article");
      const avatar = document.createElement("div");
      const content = document.createElement("div");
      const header = document.createElement("header");
      const identity = document.createElement("div");
      const author = document.createElement("a");
      const link = document.createElement("a");
      const time = document.createElement("time");
      const body = document.createElement("div");
      const createdAt = new Date(reply.created_at);
      const avatarTemplate = reply.avatar_template?.replace("{size}", "48");
      const avatarUrl = avatarTemplate
        ? (/^https?:\/\//.test(avatarTemplate)
            ? avatarTemplate
            : `${refreshConfig.discourseUrl}${avatarTemplate.startsWith("/") ? "" : "/"}${avatarTemplate}`)
        : undefined;

      avatar.className = "discussion-bridge-reply__avatar";
      avatar.setAttribute("aria-hidden", "true");
      if (avatarUrl) {
        const image = document.createElement("img");
        image.src = avatarUrl;
        image.alt = "";
        image.loading = "lazy";
        avatar.append(image);
      } else {
        const fallback = document.createElement("span");
        fallback.textContent = (reply.display_username ?? reply.username).slice(0, 1).toUpperCase();
        avatar.append(fallback);
      }
      content.className = "discussion-bridge-reply__content";
      header.className = "discussion-bridge-reply__header";
      identity.className = "discussion-bridge-reply__identity";
      author.className = "discussion-bridge-reply__author";
      author.href = `${refreshConfig.discourseUrl}/u/${encodeURIComponent(reply.username.toLowerCase())}`;
      author.textContent = reply.display_username ?? reply.username;
      time.dateTime = reply.created_at;
      time.textContent = createdAt.toLocaleDateString();
      link.className = "discussion-bridge-reply__permalink";
      link.href = `${refreshConfig.discourseUrl}/t/${reply.topic_slug}/${reply.topic_id}/${reply.post_number}`;
      link.append(time);
      body.className = "discussion-bridge-reply__body";
      body.innerHTML = absolutizeDiscourseLinks(reply.cooked, refreshConfig.discourseUrl);

      identity.append(author);
      if (reply.reply_to_user) {
        const replyTo = document.createElement("span");
        const replyToLink = document.createElement("a");
        replyTo.className = "discussion-bridge-reply__reply-to";
        replyTo.append("replying to ");
        replyToLink.href = `${refreshConfig.discourseUrl}/u/${encodeURIComponent(reply.reply_to_user.username.toLowerCase())}`;
        replyToLink.textContent = `@${reply.reply_to_user.username}`;
        replyTo.append(replyToLink);
        identity.append(replyTo);
      }
      header.append(identity, link);
      content.append(header, body);

      const actions = actionItems(reply, refreshConfig);
      if (actions.length > 0) {
        const list = document.createElement("ul");
        list.className = "discussion-bridge-reply__actions";
        list.setAttribute("aria-label", "Post actions");
        for (const action of actions) {
          const item = document.createElement("li");
          const icon = document.createElement("span");
          const value = document.createElement("span");
          item.setAttribute("aria-label", `${action.count} ${action.label}`);
          icon.setAttribute("aria-hidden", "true");
          icon.className = "discussion-bridge-reply__action-icon";
          icon.innerHTML = iconMarkup(action.icon);
          value.textContent = String(action.count);
          item.append(icon, value);
          list.append(item);
        }
        content.append(list);
      }

      article.append(avatar, content);
      item.append(article);
      return item;
    }

    function likeCount(post) {
      const likeAction = post.actions_summary?.find((action) => action.id === 2);
      return post.like_count ?? likeAction?.count ?? 0;
    }

    function actionItems(post, refreshConfig) {
      const reactions = post.reactions?.length
        ? post.reactions.map((reaction) => ({
            icon: reactionIconName(reaction.id),
            label: reactionLabel(reaction.id),
            count: reaction.count,
          }))
        : [];
      const likes = reactions.length || !refreshConfig.showLikes || likeCount(post) <= 0
        ? []
        : [{ icon: "heart", label: "likes", count: likeCount(post) }];
      return [
        ...reactions,
        ...likes,
        ...(post.reply_count > 0 ? [{ icon: "reply", label: "replies", count: post.reply_count }] : []),
        ...(post.quote_count > 0 ? [{ icon: "quote", label: "quotes", count: post.quote_count }] : []),
      ];
    }

    function reactionIconName(id) {
      const icons = {
        "+1": "thumbs-up",
        clap: "clap",
        confetti_ball: "confetti",
        heart: "heart",
        hugs: "hugs",
        laughing: "laughing",
        open_mouth: "surprise",
      };
      return icons[id] ?? id;
    }

    function reactionLabel(id) {
      const labels = {
        "+1": "thumbs up",
        clap: "claps",
        confetti_ball: "celebrations",
        heart: "likes",
        hugs: "hugs",
        laughing: "laughs",
        open_mouth: "surprises",
      };
      return labels[id] ?? id;
    }

    function absolutizeDiscourseLinks(html, baseUrl) {
      const normalizedBase = baseUrl.replace(/\/+$/, "");
      return html.replace(/\s(href|src)="\/(?!\/)([^"]*)"/g, ` $1="${normalizedBase}/$2"`);
    }

    function iconMarkup(name) {
      const icons = {
        heart: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>`,
        "thumbs-up": `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3m0 11V10l5-8a3 3 0 0 1 3 3v4h4.2a2 2 0 0 1 2 2.3l-1.4 8a2 2 0 0 1-2 1.7H7Z"/></svg>`,
        reply: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 17-5-5 5-5"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>`,
        quote: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11H4a6 6 0 0 1 6-6v2a4 4 0 0 0-4 4h2v6H4v-6Zm12 0h-4a6 6 0 0 1 6-6v2a4 4 0 0 0-4 4h2v6h-4v-6Z"/></svg>`,
        clap: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 13 4-9a2 2 0 0 1 3.7 1.5L13 12"/><path d="m11 14 5-8a2 2 0 0 1 3.5 1.9L15 16"/><path d="M5 12.5V5a2 2 0 0 1 4 0v7"/><path d="M5 12.5 3.6 9.8A2 2 0 1 0 .1 11.7L4.5 20A4 4 0 0 0 8 22h6a5 5 0 0 0 5-5v-1"/></svg>`,
        confetti: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 20 5-14 9 9-14 5Z"/><path d="M14 4h.01"/><path d="M20 9h.01"/><path d="M16 2l1 2"/><path d="M21 5l-2 1"/></svg>`,
        hugs: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11a4 4 0 1 1 8 0"/><path d="M4 21v-2a6 6 0 0 1 12 0v2"/><path d="M16 14c2.2.5 4 2.4 4 5v2"/></svg>`,
        laughing: `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 9h.01"/><path d="M16 9h.01"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/></svg>`,
        surprise: `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 9h.01"/><path d="M16 9h.01"/><circle cx="12" cy="15" r="2"/></svg>`,
      };
      return icons[name] ?? `<span class="discussion-bridge-reply__action-text">${name}</span>`;
    }
  </script>
)}

<style is:global>
  .discussion-bridge-replies {
    margin-block-start: 3rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
    padding-block-start: 2rem;
  }

  .discussion-bridge-replies__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .discussion-bridge-replies__header h2 {
    margin: 0;
    font-size: var(--sl-text-h3);
  }

  .discussion-bridge-replies__header a,
  .discussion-bridge-reply__actions {
    font-size: var(--sl-text-sm);
  }

  .discussion-bridge-replies ol {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .discussion-bridge-replies article {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: 1rem;
    margin: 0;
    border-block-start: 1px solid var(--sl-color-gray-5);
    padding: 1.25rem 0;
  }

  .discussion-bridge-replies li:first-child article {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .discussion-bridge-replies [data-discussion-bridge-unavailable],
  .discussion-bridge-replies [data-discussion-bridge-empty] {
    border-block-start: 1px solid var(--sl-color-gray-5);
    color: #62665d;
    padding: 1rem 0;
  }

  .discussion-bridge-replies [data-discussion-bridge-unavailable] a {
    margin-inline-start: 0.35rem;
  }

  .discussion-bridge-reply__avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    overflow: hidden;
    background: #e5e0d6;
    color: #232421;
    display: grid;
    place-items: center;
    font-weight: 700;
    line-height: 1;
  }

  .discussion-bridge-reply__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .discussion-bridge-reply__content {
    min-width: 0;
  }

  .discussion-bridge-reply__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    align-items: start;
    gap: 0.75rem;
    margin-block-end: 0.45rem;
    line-height: 1.3;
  }

  .discussion-bridge-reply__identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.625rem;
    min-width: 0;
  }

  .discussion-bridge-reply__author {
    color: inherit;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .discussion-bridge-reply__author:hover {
    text-decoration: underline;
  }

  .discussion-bridge-reply__reply-to {
    color: #62665d;
    font-size: 0.875rem;
  }

  .discussion-bridge-reply__permalink {
    color: #62665d;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .discussion-bridge-reply__permalink:hover {
    text-decoration: underline;
  }

  .discussion-bridge-reply__body {
    overflow-wrap: anywhere;
  }

  .discussion-bridge-reply__body > :first-child {
    margin-block-start: 0;
  }

  .discussion-bridge-reply__body > :last-child {
    margin-block-end: 0;
  }

  .discussion-bridge-reply__body table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

