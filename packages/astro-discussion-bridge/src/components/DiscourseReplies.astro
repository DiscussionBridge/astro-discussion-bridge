---
import config from "virtual:discussion-bridge/config";
import { createDiscourseClient, type DiscoursePost } from "astro-discussion-bridge/client";

interface Props {
  topicId?: number | string;
  minScore?: number;
  maxReplies?: number;
  discourseUrl?: string;
  heading?: string;
  refreshOnPageLoad?: boolean;
  showLikes?: boolean;
  class?: string;
  topicUrl?: string;
}

const topicId = Astro.props.topicId ?? Astro.props.frontmatter?.discourseTopicId;
const minScore = Astro.props.minScore ?? config.replies.minScore;
const maxReplies = Astro.props.maxReplies ?? config.replies.maxReplies;
const discourseUrl = Astro.props.discourseUrl ?? config.discourseUrl;
const heading = Astro.props.heading ?? "Discussion";
const refreshOnPageLoad = Astro.props.refreshOnPageLoad ?? config.replies.refreshOnPageLoad;
const showLikes = Astro.props.showLikes ?? config.replies.showLikes;
const topicUrl = Astro.props.topicUrl ?? Astro.props.frontmatter?.discourseTopicUrl;
let replies: DiscoursePost[] = [];

if (config.replies.enabled && topicId) {
  const discourse = createDiscourseClient({ discourseUrl });
  const topic = await discourse.topic(topicId);
  replies = topic.post_stream.posts
    .filter((post) => post.post_number > 1)
    .filter((post) => post.score >= minScore)
    .slice(0, maxReplies);
}

function likeCount(post: DiscoursePost): number {
  const likeAction = post.actions_summary?.find((action) => action.id === 2);
  return post.like_count ?? likeAction?.count ?? 0;
}

function replyUrl(post: DiscoursePost): string {
  return `${discourseUrl}/t/${post.topic_slug}/${post.topic_id}/${post.post_number}`;
}

const refreshConfig = topicId
  ? {
      discourseUrl,
      maxReplies,
      minScore,
      refreshEndpoint: config.replies.refreshEndpoint,
      showLikes,
      topicId: String(topicId),
    }
  : undefined;
---

{config.replies.enabled && topicId && (
  <section
    class:list={["discussion-bridge-replies", Astro.props.class]}
    data-discussion-bridge-replies
    data-refresh={refreshOnPageLoad ? "true" : "false"}
    data-refresh-config={refreshConfig ? JSON.stringify(refreshConfig) : undefined}
  >
    <div class="discussion-bridge-replies__header">
      <h2>{heading}</h2>
      {topicUrl && <a href={topicUrl}>Open full discussion</a>}
    </div>
    <ol data-discussion-bridge-replies-list>
      {replies.length > 0 ? (
        replies.map((reply) => (
          <li>
            <article>
              <header class="discussion-bridge-reply__header">
                <strong class="discussion-bridge-reply__author">{reply.display_username ?? reply.username}</strong>
                <a class="discussion-bridge-reply__permalink" href={replyUrl(reply)}>
                  <time datetime={reply.created_at}>{new Date(reply.created_at).toLocaleDateString()}</time>
                </a>
              </header>
              <div class="discussion-bridge-reply__body" set:html={reply.cooked} />
              {showLikes && likeCount(reply) > 0 && (
                <p class="discussion-bridge-replies__meta">
                  <span aria-hidden="true">♡</span>
                  <span>{likeCount(reply)}</span>
                </p>
              )}
            </article>
          </li>
        ))
      ) : (
        <li data-discussion-bridge-empty>Loading discussion...</li>
      )}
    </ol>
  </section>
)}

{config.replies.enabled && refreshOnPageLoad && topicId && (
  <script>
    const containers = document.querySelectorAll("[data-discussion-bridge-replies][data-refresh='true']");

    for (const container of containers) {
      const configValue = container.getAttribute("data-refresh-config");
      const list = container.querySelector("[data-discussion-bridge-replies-list]");
      if (!configValue || !list) continue;

      try {
        const refreshConfig = JSON.parse(configValue);
        const topicUrl = refreshConfig.refreshEndpoint
          ? refreshConfig.refreshEndpoint.replace("{topicId}", encodeURIComponent(refreshConfig.topicId))
          : `${refreshConfig.discourseUrl}/t/${refreshConfig.topicId}.json`;
        const response = await fetch(topicUrl, { headers: { Accept: "application/json" } });
        if (!response.ok) continue;

        const topic = await response.json();
        const replies = topic.post_stream.posts
          .filter((post) => post.post_number > 1)
          .filter((post) => post.score >= refreshConfig.minScore)
          .slice(0, refreshConfig.maxReplies);

        list.replaceChildren(...replies.map((reply) => renderReply(reply, refreshConfig)));
      } catch {
        // Keep the server-rendered fallback if the live refresh is unavailable.
      }
    }

    function renderReply(reply, refreshConfig) {
      const item = document.createElement("li");
      const article = document.createElement("article");
      const header = document.createElement("header");
      const author = document.createElement("strong");
      const link = document.createElement("a");
      const time = document.createElement("time");
      const body = document.createElement("div");
      const createdAt = new Date(reply.created_at);

      header.className = "discussion-bridge-reply__header";
      author.className = "discussion-bridge-reply__author";
      author.textContent = reply.display_username ?? reply.username;
      time.dateTime = reply.created_at;
      time.textContent = createdAt.toLocaleDateString();
      link.className = "discussion-bridge-reply__permalink";
      link.href = `${refreshConfig.discourseUrl}/t/${reply.topic_slug}/${reply.topic_id}/${reply.post_number}`;
      link.append(time);
      body.className = "discussion-bridge-reply__body";
      body.innerHTML = reply.cooked;

      header.append(author, link);
      article.append(header, body);

      const count = likeCount(reply);
      if (refreshConfig.showLikes && count > 0) {
        const meta = document.createElement("p");
        const icon = document.createElement("span");
        const value = document.createElement("span");
        meta.className = "discussion-bridge-replies__meta";
        icon.setAttribute("aria-hidden", "true");
        icon.textContent = "♡";
        value.textContent = String(count);
        meta.append(icon, value);
        article.append(meta);
      }

      item.append(article);
      return item;
    }

    function likeCount(post) {
      const likeAction = post.actions_summary?.find((action) => action.id === 2);
      return post.like_count ?? likeAction?.count ?? 0;
    }
  </script>
)}

<style>
  .discussion-bridge-replies {
    margin-block-start: 3rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
    padding-block-start: 2rem;
  }

  .discussion-bridge-replies__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .discussion-bridge-replies__header h2 {
    margin: 0;
    font-size: var(--sl-text-h3);
  }

  .discussion-bridge-replies__header a,
  .discussion-bridge-replies__meta {
    font-size: var(--sl-text-sm);
  }

  .discussion-bridge-replies ol {
    display: grid;
    gap: 0.875rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .discussion-bridge-replies article {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    padding: 1rem 1.125rem;
  }

  .discussion-bridge-reply__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    margin-block-end: 0.625rem;
    line-height: 1.3;
  }

  .discussion-bridge-reply__author {
    color: inherit;
    font-size: 1rem;
  }

  .discussion-bridge-reply__permalink {
    color: #62665d;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .discussion-bridge-reply__permalink:hover {
    text-decoration: underline;
  }

  .discussion-bridge-reply__body > :first-child {
    margin-block-start: 0;
  }

  .discussion-bridge-reply__body > :last-child {
    margin-block-end: 0;
  }

  .discussion-bridge-replies__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-block: 0.75rem 0;
    color: #62665d;
    line-height: 1;
  }
</style>


