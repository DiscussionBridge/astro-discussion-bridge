---
import sanitizeHtml from "sanitize-html";
import discourseWordmark from "../assets/discourse-wordmark.svg?raw";
import config from "virtual:discussion-bridge/config";
import { resolveConnectedForumName, resolveForumName } from "../forum-name";
import { normalizeTopicId, parsePublicTopicJson } from "../topic-identity";
import { closeResponse, readBoundedResponseBytes } from "../response-body";
import {
  normalizeServiceBaseUrl,
  parsePublicDiscourseTopicUrl,
  readPublicForumSettings,
  nativeUrl, cmsFetch, type NativeUrl,
} from "astro-discussion-bridge/server-url";

interface Props {
  class?: string;
  discourseUrl?: string;
  heading?: string;
  topicId?: unknown;
  topicUrl?: unknown;
  /** Effective connected label, not a local override. */
  forumName?: unknown;
  connectedSource?: boolean;
}

interface PublicPost {
  id: number;
  avatar_template?: string;
  cooked: string;
  created_at: string;
  display_username?: string;
  post_number: number;
  topic_id: string;
  topic_slug: string;
  username: string;
}

const MAX_RESPONSE_BYTES = 512 * 1024;
const MAX_REPLIES = 50;
const INITIAL_REPLIES = 5;
const FETCH_BATCH_SIZE = 20;
const discourseUrl = normalizeServiceBaseUrl(
  Astro.props.discourseUrl ?? config.discourseUrl,
  "DiscourseReplies discourseUrl",
);
const topicReference = Astro.props.topicUrl === undefined
  ? undefined
  : parsePublicDiscourseTopicUrl(
      requiredString(Astro.props.topicUrl, "DiscourseReplies topicUrl"),
      discourseUrl,
      "DiscourseReplies topicUrl",
    );
const topicId = normalizeTopicId(Astro.props.topicId, "DiscourseReplies topicId")
  ?? normalizeTopicId(topicReference?.topicId, "DiscourseReplies topicUrl ID");
if (!topicId) throw new Error("DiscourseReplies requires one public topic ID.");
if (topicReference && String(topicReference.topicId) !== topicId) {
  throw new Error("DiscourseReplies topicId and topicUrl must identify the same topic.");
}

const topicUrl = topicReference?.href ?? `${discourseUrl}/t/${topicId}`;
const endpoint = nativeUrl(`/t/${topicId}.json`, `${discourseUrl}/`);
const payload = await publicTopicJson(endpoint);
const stream = payload.post_stream?.stream;
if (!Array.isArray(stream)) throw new Error("DiscourseReplies requires a topic post stream.");
const replyIds = stream.slice(1, MAX_REPLIES + 1).map((value) => positiveTopicId(value, "DiscourseReplies post stream ID")!);
const postsById = new Map<number, PublicPost>();
for (const post of payload.post_stream?.posts ?? []) {
  if (validPublicPost(post, topicId)) postsById.set(post.id, post);
}
const missingIds = replyIds.filter((id) => !postsById.has(id));
for (let offset = 0; offset < missingIds.length; offset += FETCH_BATCH_SIZE) {
  const batch = missingIds.slice(offset, offset + FETCH_BATCH_SIZE);
  const postsEndpoint = nativeUrl(`/t/${topicId}/posts.json`, `${discourseUrl}/`);
  for (const id of batch) postsEndpoint.searchParams.append("post_ids[]", String(id));
  const additional = await publicTopicJson(postsEndpoint);
  for (const post of additional.post_stream?.posts ?? []) {
    if (!validPublicPost(post, topicId)) throw new Error("DiscourseReplies received an invalid public post.");
    postsById.set(post.id, post);
  }
}
const replies = replyIds.map((id) => {
  const post = postsById.get(id);
  if (!post) throw new Error("DiscourseReplies could not resolve the complete bounded reply set.");
  return post;
});
const initialReplies = replies.slice(0, INITIAL_REPLIES);
const remainingReplies = replies.slice(INITIAL_REPLIES);
const exceedsBound = stream.length - 1 > MAX_REPLIES;
const heading = Astro.props.heading ?? "Comments";
const settings = await readPublicForumSettings(discourseUrl, cmsFetch).catch(() => undefined);
const forumName = Astro.props.connectedSource
  ? await resolveConnectedForumName(Astro.props.forumName)
  : resolveForumName(config.forumName, settings?.title);
const poweredBy = settings?.poweredBy ?? false;

interface TopicPayload {
  post_stream?: { posts?: unknown[]; stream?: unknown[] };
}

async function publicTopicJson(url: NativeUrl): Promise<TopicPayload> {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 10_000);
  let response: Response | undefined;
  try {
    response = await cmsFetch(url.href, {
      method: "GET", credentials: "omit", headers: { Accept: "application/json", "Accept-Encoding": "identity" },
      redirect: "error",
      signal: controller.signal,
    });
    if (!response.ok) throw new Error(`DiscourseReplies request failed with HTTP ${response.status}.`);
    if (response.headers.get("content-type")?.split(";", 1)[0].toLowerCase() !== "application/json") {
      throw new Error("DiscourseReplies requires an application/json response.");
    }
    const responseText = new TextDecoder().decode(await readBoundedResponseBytes(response, MAX_RESPONSE_BYTES, controller.signal));
    const decoded = parsePublicTopicJson(responseText);
    if (!decoded || typeof decoded !== "object") throw new Error("DiscourseReplies response JSON is invalid.");
    return decoded as TopicPayload;
  } finally { closeResponse(response, controller); clearTimeout(timeout); }
}

function validPublicPost(value: unknown, expectedTopicId: string): value is PublicPost {
  if (!value || typeof value !== "object") return false;
  const post = value as Partial<PublicPost>;
  return Number.isSafeInteger(post.id) && Number(post.id) > 0
    && Number.isSafeInteger(post.post_number) && Number(post.post_number) > 1
    && post.topic_id === expectedTopicId
    && typeof post.topic_slug === "string" && /^[a-z0-9-]+$/.test(post.topic_slug)
    && typeof post.username === "string" && post.username.trim().length > 0 && post.username.length <= 100
    && typeof post.created_at === "string" && Number.isFinite(Date.parse(post.created_at))
    && typeof post.cooked === "string";
}

function positiveTopicId(value: unknown, label: string): number | undefined {
  if (value === undefined) return undefined;
  const text = typeof value === "number" ? String(value) : value;
  if (typeof text !== "string" || !/^[1-9]\d*$/.test(text) || !Number.isSafeInteger(Number(text))) {
    throw new Error(`${label} must be a positive safe integer.`);
  }
  return Number(text);
}

function requiredString(value: unknown, label: string): string {
  if (typeof value !== "string" || !value.trim()) throw new Error(`${label} must be a non-empty string.`);
  return value.trim();
}

function postUrl(post: PublicPost): string {
  return `${discourseUrl}/t/${encodeURIComponent(post.topic_slug)}/${post.topic_id}/${post.post_number}`;
}

function avatarUrl(post: PublicPost): string | undefined {
  const template = post.avatar_template?.replace("{size}", "48");
  if (!template) return undefined;
  return nativeUrl(template, `${discourseUrl}/`).href;
}

function cookedHtml(post: PublicPost): string {
  const absolute = post.cooked.replace(/\s(href|src)="\/(?!\/)([^"]*)"/g, ` $1="${discourseUrl}/$2"`);
  return sanitizeHtml(absolute, {
    allowedTags: [...sanitizeHtml.defaults.allowedTags, "img"],
    allowedAttributes: {
      ...sanitizeHtml.defaults.allowedAttributes,
      img: ["alt", "height", "loading", "src", "width"],
    },
    allowedSchemes: ["http", "https"],
  });
}
---

<section
  class:list={["discussion-bridge-simple", Astro.props.class]}
  data-discussionbridge-simple-live
  data-discourse-origin={discourseUrl}
  data-topic-id={topicId}
  data-topic-url={topicUrl}
  data-forum-name={Astro.props.connectedSource ? forumName : config.forumName}
  data-discussionbridge-mode="simple"
>
  <div class="discussion-bridge-simple__header"><h2>{heading}</h2><a href={topicUrl}>Join the discussion</a></div>
  {replies.length ? (
    <>
    <ol>{initialReplies.map((post) => (
      <li><article>
        <div class="discussion-bridge-simple__avatar" aria-hidden="true">{avatarUrl(post) ? <img src={avatarUrl(post)} alt="" loading="lazy" /> : post.username.slice(0, 1).toUpperCase()}</div>
        <div><header><strong>{post.display_username ?? post.username}</strong><a href={postUrl(post)}><time datetime={post.created_at}>{new Date(post.created_at).toLocaleDateString()}</time></a></header><div class="discussion-bridge-simple__body" set:html={cookedHtml(post)} /></div>
      </article></li>
    ))}</ol>
    {remainingReplies.length ? (
      <details class="discussion-bridge-simple__more">
        <summary><span class="discussion-bridge-simple__more-closed">Show {remainingReplies.length} more {remainingReplies.length === 1 ? "comment" : "comments"}</span><span class="discussion-bridge-simple__more-open">Show fewer comments</span></summary>
        <ol>{remainingReplies.map((post) => (
          <li><article>
            <div class="discussion-bridge-simple__avatar" aria-hidden="true">{avatarUrl(post) ? <img src={avatarUrl(post)} alt="" loading="lazy" /> : post.username.slice(0, 1).toUpperCase()}</div>
            <div><header><strong>{post.display_username ?? post.username}</strong><a href={postUrl(post)}><time datetime={post.created_at}>{new Date(post.created_at).toLocaleDateString()}</time></a></header><div class="discussion-bridge-simple__body" set:html={cookedHtml(post)} /></div>
          </article></li>
        ))}</ol>
      </details>
    ) : null}
    {exceedsBound ? <p class="discussion-bridge-simple__limit">Showing the first {MAX_REPLIES} comments. <a href={topicUrl}>View the complete discussion on {forumName}</a>.</p> : null}
    </>
  ) : <p>No comments yet. <a href={topicUrl}>Start the conversation on Discourse.</a></p>}
  <div data-discussionbridge-attributions>
    <a class="discussion-bridge-powered-by" data-discussionbridge-powered-by href="https://www.discourse.org/powered-by" aria-label="Powered by Discourse" hidden={!poweredBy}>
      <span>Powered by</span><span class="discussion-bridge-powered-by__wordmark" set:html={discourseWordmark} />
    </a>
  </div>
  <p data-discussionbridge-simple-status hidden>Live comments are temporarily unavailable; showing the most recently published snapshot.</p>
</section>

<script>
  import { startSimpleComments } from "astro-discussion-bridge/simple-live";
  startSimpleComments();
</script>

<style is:global>
  .discussion-bridge-simple { margin-block-start: 3rem; border-block-start: 1px solid var(--sl-color-gray-5); padding-block-start: 2rem; }
  .discussion-bridge-simple__header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .discussion-bridge-simple__header h2 { margin: 0; font-size: var(--sl-text-h3); }
  .discussion-bridge-simple ol { display: grid; gap: 1rem; padding: 0; list-style: none; }
  .discussion-bridge-simple article { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 1rem; padding-block: 1rem; border-block-start: 1px solid var(--sl-color-gray-5); }
  .discussion-bridge-simple__avatar { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; overflow: hidden; border-radius: 50%; background: var(--sl-color-gray-6); font-weight: 700; }
  .discussion-bridge-simple__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .discussion-bridge-simple header { display: flex; justify-content: space-between; gap: 1rem; }
  .discussion-bridge-simple__body { overflow-wrap: anywhere; }
  .discussion-bridge-simple__body img { max-width: 100%; height: auto; }
  .discussion-bridge-simple__more { border: 0; }
  .discussion-bridge-simple__more summary { width: max-content; max-width: 100%; margin: 1rem auto; border: 1px solid var(--sl-color-gray-5); border-radius: 999px; padding: .55rem .9rem; cursor: pointer; font-weight: 700; }
  .discussion-bridge-simple__more-open { display: none; }
  .discussion-bridge-simple__more[open] .discussion-bridge-simple__more-closed { display: none; }
  .discussion-bridge-simple__more[open] .discussion-bridge-simple__more-open { display: inline; }
  .discussion-bridge-simple__limit { text-align: center; font-size: var(--sl-text-sm); }
  .discussion-bridge-powered-by { display: flex; align-items: center; justify-content: center; gap: .45rem; margin: .8rem auto 0; color: inherit; font-size: .8rem; text-decoration: none; opacity: .72; }
  .discussion-bridge-powered-by[hidden] { display: none; }
  .discussion-bridge-powered-by__wordmark { display: inline-flex; width: 6.4rem; padding: .12rem .28rem; border-radius: .2rem; background: #fff; }
  .discussion-bridge-powered-by__wordmark svg { display: block; width: 100%; height: auto; }
</style>
