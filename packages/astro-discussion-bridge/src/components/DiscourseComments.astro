---
import DiscourseDiscussion from "./DiscourseDiscussion.astro";

interface Props {
  class?: string;
  embedClassName?: string;
  embedUrl?: string;
  heading?: string;
  topicId?: number | string;
  topicUrl?: string;
}
---

<DiscourseDiscussion
  class={Astro.props.class}
  embedClassName={Astro.props.embedClassName}
  embedUrl={Astro.props.embedUrl}
  heading={Astro.props.heading}
  topicId={Astro.props.topicId}
  topicUrl={Astro.props.topicUrl}
/>
