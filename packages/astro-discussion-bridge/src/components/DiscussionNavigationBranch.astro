---
import type { NavigationNode } from "astro-discussion-bridge";

interface Props {
  activeIds: string[];
  node: NavigationNode;
}

const { activeIds, node } = Astro.props;
const active = activeIds.includes(node.id);
const href = node.url ?? node.sourceUrl;
---

<li class:list={["discussion-bridge-navigation-node", `is-${node.kind}`, { "is-active": active }]}>
  {node.children.length > 0
    ? (
      <details open={active}>
        <summary>{node.label}</summary>
        <ul>
          <li>
            <a href={href} aria-current={active && activeIds.at(-1) === node.id ? "page" : undefined}>
              Overview
            </a>
          </li>
          {node.children.map((child) => (
            <Astro.self node={child} activeIds={activeIds} />
          ))}
        </ul>
      </details>
    )
    : (
      <a href={href} aria-current={active ? "page" : undefined}>{node.label}</a>
    )}
</li>
