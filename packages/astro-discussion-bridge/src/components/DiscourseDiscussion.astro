---
import config from "virtual:discussion-bridge/config";

interface Props {
  class?: string;
  embedUrl?: string;
  fullApp?: boolean;
  heading?: string;
  topicUrl?: string;
}

const discourseUrl = `${config.discourseUrl}/`;
const embedUrl = Astro.props.embedUrl ?? Astro.url.href;
const fullApp = Astro.props.fullApp ?? config.comments.display === "fullInteractive";
const embedHeight = config.comments.embedHeight;
const heading = Astro.props.heading ?? "Comments";
const topicUrl = Astro.props.topicUrl ?? Astro.props.frontmatter?.discourseTopicUrl;
const fullAppEmbedUrl = `${discourseUrl}embed/comments?embed_url=${encodeURIComponent(embedUrl)}&full_app=true`;
---

{config.comments.enabled && (
  <section class:list={["discussion-bridge-discussion", Astro.props.class]}>
    <div class="discussion-bridge-discussion__header">
      <h2>{heading}</h2>
      {topicUrl && <a href={topicUrl}>Open discussion</a>}
    </div>
    {fullApp ? (
      <iframe
        class="discussion-bridge-discussion__iframe"
        id="discourse-embed-frame"
        src={fullAppEmbedUrl}
        title={heading}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        sandbox="allow-same-origin allow-scripts allow-forms"
        style={`height: ${embedHeight};`}
      />
    ) : (
      <div id="discourse-comments"></div>
    )}
  </section>
)}

{config.comments.enabled && !fullApp && (
  <script define:vars={{ discourseUrl, embedUrl, fullApp, embedHeight }}>
    window.DiscourseEmbed = {
      discourseUrl,
      discourseEmbedUrl: embedUrl,
      ...(fullApp ? { fullApp: true, embedHeight } : {}),
    };

    const script = document.createElement("script");
    script.async = true;
    script.src = `${discourseUrl}javascripts/embed.js`;
    document.body.appendChild(script);
  </script>
)}

<style>
  .discussion-bridge-discussion {
    margin-block-start: 3rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
    padding-block-start: 2rem;
  }

  .discussion-bridge-discussion__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .discussion-bridge-discussion__header h2 {
    margin: 0;
    font-size: var(--sl-text-h3);
  }

  .discussion-bridge-discussion__header a {
    font-size: var(--sl-text-sm);
  }

  .discussion-bridge-discussion__iframe {
    display: block;
    width: 100%;
    border: 0;
  }
</style>

