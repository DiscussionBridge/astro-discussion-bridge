---
import config from "virtual:discussion-bridge/config";

interface Props {
  class?: string;
  discourseUrl?: string;
  embedClassName?: string;
  embedUrl?: string;
  fullApp?: boolean;
  heading?: string;
  topicId?: number | string;
  topicUrl?: string;
}

const discourseUrl = `${Astro.props.discourseUrl ?? config.discourseUrl}/`;
const embedClassName = Astro.props.embedClassName ?? config.comments.className;
const embedUrl = Astro.props.embedUrl ?? Astro.url.href;
const fullApp = Astro.props.fullApp ?? config.comments.display === "fullInteractive";
const embedHeight = config.comments.embedHeight;
const dynamicHeight = config.comments.dynamicHeight;
const embedMinHeight = config.comments.embedMinHeight;
const embedMaxHeight = config.comments.embedMaxHeight;
const embedViewportMaxHeight = config.comments.embedViewportMaxHeight;
const heading = Astro.props.heading ?? "Comments";
const topicId = Astro.props.topicId;
const topicUrl = Astro.props.topicUrl ?? Astro.props.frontmatter?.discourseTopicUrl;
---

{config.comments.enabled && (
  <section class:list={["discussion-bridge-discussion", Astro.props.class]}>
    <div class="discussion-bridge-discussion__header">
      <h2>{heading}</h2>
      {topicUrl && <a href={topicUrl}>Open discussion</a>}
    </div>
    <div id="discourse-comments"></div>
  </section>
)}

{config.comments.enabled && (
  <script define:vars={{ discourseUrl, embedClassName, embedUrl, fullApp, embedHeight, dynamicHeight, embedMinHeight, embedMaxHeight, embedViewportMaxHeight, topicId }}>
    window.DiscourseEmbed = {
      discourseUrl,
      ...(topicId ? { topicId } : { discourseEmbedUrl: embedUrl }),
      ...(embedClassName ? { className: embedClassName } : {}),
      ...(fullApp ? { fullApp: true, embedHeight, dynamicHeight, embedMinHeight, embedMaxHeight } : {}),
    };

    // Discourse reports the full embedded-app document height. Keep that
    // content-aware resize behavior, but prevent a long first post from making
    // the comments boundary consume most of a reader's viewport.
    if (fullApp && dynamicHeight && embedViewportMaxHeight) {
      const comments = document.getElementById("discourse-comments");
      const applyViewportCeiling = () => {
        const iframe = comments?.querySelector("#discourse-embed-frame");
        if (!(iframe instanceof HTMLIFrameElement)) return false;
        iframe.style.maxHeight = embedViewportMaxHeight;
        return true;
      };
      if (!applyViewportCeiling() && comments) {
        const observer = new MutationObserver(() => {
          if (applyViewportCeiling()) observer.disconnect();
        });
        observer.observe(comments, { childList: true });
      }
    }

    const script = document.createElement("script");
    script.async = true;
    script.src = `${discourseUrl}javascripts/embed.js`;
    document.body.appendChild(script);
  </script>
)}

<style>
  .discussion-bridge-discussion {
    margin-block-start: 3rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
    padding-block-start: 2rem;
  }

  .discussion-bridge-discussion__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .discussion-bridge-discussion__header h2 {
    margin: 0;
    font-size: var(--sl-text-h3);
  }

  .discussion-bridge-discussion__header a {
    font-size: var(--sl-text-sm);
  }
</style>

