---
import config from "virtual:discussion-bridge/config";
import discussionLabels from "../assets/discussion-labels.js?raw";
import { resolveForumName, validateForumName } from "../forum-name";
import {
  normalizePublicHttpUrl,
  normalizeServiceBaseUrl,
  parsePublicDiscourseTopicUrl,
  readPublicForumSettings, cmsFetch,
} from "astro-discussion-bridge/server-url";
import { isInteractiveCommentsMode } from "../comments-mode";
import { normalizeTopicId } from "../topic-identity";

interface Props {
  class?: string;
  discourseUrl?: string;
  embedClassName?: string;
  frontmatter?: Record<string, unknown>;
  fullApp?: boolean;
  heading?: string;
  sourceUrl?: unknown;
  topicId?: unknown;
  topicUrl?: unknown;
  forumName?: unknown;
  connectedSource?: boolean;
}

const discourseUrl = `${normalizeServiceBaseUrl(
  Astro.props.discourseUrl ?? config.discourseUrl,
  "DiscourseDiscussion discourseUrl",
)}/`;
const embedClassName = Astro.props.embedClassName ?? config.comments.className;
const embedHeight = config.comments.embedHeight;
const dynamicHeight = config.comments.dynamicHeight;
const embedMinHeight = config.comments.embedMinHeight;
const fullApp = Astro.props.fullApp ?? isInteractiveCommentsMode(config.comments.display);
const heading = Astro.props.heading ?? "Discussion";
const topicIdValue = Astro.props.topicId ?? Astro.props.frontmatter?.discourseTopicId;
const topicId = normalizeTopicId(topicIdValue, "DiscourseDiscussion topicId");
const topicUrlValue = Astro.props.topicUrl ?? Astro.props.frontmatter?.discourseTopicUrl;
const topicReference = topicUrlValue === undefined
  ? undefined
  : parsePublicDiscourseTopicUrl(
      requiredString(topicUrlValue, "DiscourseDiscussion topicUrl"),
      discourseUrl,
      "DiscourseDiscussion topicUrl",
    );
if (topicId !== undefined && topicReference && String(topicReference.topicId) !== topicId) {
  throw new Error("DiscourseDiscussion topicId and topicUrl must identify the same topic.");
}
const resolvedTopicId = topicId ?? normalizeTopicId(topicReference?.topicId, "DiscourseDiscussion topicUrl ID");
const topicUrl = topicReference?.href ?? (resolvedTopicId ? new URL(`t/${resolvedTopicId}`, discourseUrl).href : undefined);
let forumName = "";
if (config.comments.enabled && topicUrl) {
  try {
    const supplied = Astro.props.forumName ?? Astro.props.frontmatter?.discussionbridgeForumName;
    if (Astro.props.connectedSource && supplied !== undefined) forumName = validateForumName(supplied);
    else {
      const settings = config.forumName === undefined ? await readPublicForumSettings(discourseUrl, cmsFetch) : undefined;
      forumName = resolveForumName(config.forumName, settings?.title);
    }
  } catch {
    // An unavailable optional label does not hide a known discussion.
  }
}
const sourceUrl = resolvedTopicId === undefined
  ? normalizePublicHttpUrl(
      requiredString(Astro.props.sourceUrl ?? Astro.url.href, "DiscourseDiscussion sourceUrl"),
      "DiscourseDiscussion sourceUrl",
    )
  : undefined;
if (config.comments.enabled && fullApp && resolvedTopicId === undefined) {
  throw new Error("DiscourseDiscussion Interactive requires one completed Bridge topic mapping.");
}

function requiredString(value: unknown, label: string): string {
  if (typeof value !== "string" || !value.trim()) throw new Error(`${label} must be a non-empty string.`);
  return value;
}
---

{config.comments.enabled && (
  <section class:list={["discussion-bridge-discussion", Astro.props.class]}
    data-discussionbridge-mode={fullApp ? "interactive" : "full"}
    data-discussionbridge-topic-id={resolvedTopicId}
    data-discussionbridge-discourse-url={discourseUrl}>
    <div class="discussion-bridge-discussion__header">
      <h2>{heading}</h2>
      {topicUrl && <a href={topicUrl} data-discussionbridge-forum-label={forumName ? `Open in ${forumName}` : ""}>Open in forum</a>}
    </div>
    <div id="discourse-comments"></div>
  </section>
)}

{config.comments.enabled && topicUrl && <script is:inline set:html={discussionLabels}></script>}

{config.comments.enabled && (
  <script define:vars={{ discourseUrl, embedClassName, embedHeight, dynamicHeight, embedMinHeight, fullApp, resolvedTopicId, sourceUrl }}>
    window.DiscourseEmbed = {
      discourseUrl,
      ...(resolvedTopicId ? { topicId: resolvedTopicId } : { discourseEmbedUrl: sourceUrl }),
      ...(embedClassName ? { className: embedClassName } : {}),
      ...(fullApp ? { fullApp: true, embedHeight, dynamicHeight, embedMinHeight } : {}),
    };

    const script = document.createElement("script");
    script.async = true;
    script.src = `${discourseUrl}javascripts/embed.js`;
    document.body.appendChild(script);
  </script>
)}

<style>
  .discussion-bridge-discussion {
    margin-block-start: 3rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
    padding-block-start: 2rem;
  }

  .discussion-bridge-discussion__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1rem;
  }

  .discussion-bridge-discussion__header h2 {
    margin: 0;
    font-size: var(--sl-text-h3);
  }

  .discussion-bridge-discussion__header a {
    font-size: var(--sl-text-sm);
  }
</style>

