---
import relationshipManifest from "virtual:discussion-bridge/relationships";
import {
  parseRelationshipManifest,
  resolveContentRelationships,
  type ContentRelationshipManifest,
} from "astro-discussion-bridge";

interface Props {
  class?: string;
  contentLens?: string;
  currentUrl?: string;
  frontmatter?: Record<string, unknown>;
  manifest?: ContentRelationshipManifest;
  sectionIds?: string[] | string;
}

const frontmatter = Astro.props.frontmatter;
const manifest = Astro.props.manifest
  ? parseRelationshipManifest(Astro.props.manifest)
  : parseRelationshipManifest(relationshipManifest);
const relationships = resolveContentRelationships({
  manifest,
  currentUrl: Astro.props.currentUrl ?? Astro.url.href,
  sectionIds: Astro.props.sectionIds
    ?? sectionIdsValue(frontmatter?.sectionIds ?? frontmatter?.sectionId),
  contentLens: Astro.props.contentLens ?? stringValue(frontmatter?.contentLens),
});
const className = ["discussion-bridge-relations", Astro.props.class].filter(Boolean).join(" ");

function stringValue(value: unknown): string | undefined {
  return typeof value === "string" && value.trim() ? value.trim() : undefined;
}

function sectionIdsValue(value: unknown): string[] | string | undefined {
  if (Array.isArray(value)) {
    return value
      .map((item) => typeof item === "number" ? String(item) : stringValue(item))
      .filter((item): item is string => Boolean(item));
  }
  return typeof value === "number" ? String(value) : stringValue(value);
}
---

{relationships.length > 0 && (
  <nav class={className} aria-label="Related content">
    <strong>Related:</strong>
    <ul>
      {relationships.map((relationship) => (
        <li>
          {relationship.entries.length === 1
            ? <a href={relationship.entries[0].url}>{relationship.callToAction}</a>
            : <>
                <span>{relationship.callToAction}:</span>{" "}
                {relationship.entries.map((entry, index) => (
                  <>
                    {index > 0 && <span aria-hidden="true"> · </span>}
                    <a href={entry.url}>{entry.title}</a>
                  </>
                ))}
              </>}
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .discussion-bridge-relations {
    margin-block: 1.25rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--sl-color-gray-5, #d6d9df);
    font-size: 0.9375rem;
  }

  .discussion-bridge-relations ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .discussion-bridge-relations li {
    margin: 0;
  }
</style>
