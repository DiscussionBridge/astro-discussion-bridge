{
  "name": "astro-discussion-bridge",
  "version": "0.2.0-alpha.19",
  "description": "Two-direction Astro adapter with plugin-free simple/full comments and plugin-backed fullInteractive discussion.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiscussionBridge/astro-discussion-bridge.git",
    "directory": "packages/astro-discussion-bridge"
  },
  "bugs": {
    "url": "https://github.com/DiscussionBridge/astro-discussion-bridge/issues"
  },
  "homepage": "https://github.com/DiscussionBridge/astro-discussion-bridge#readme",
  "main": "./dist/index.js",
  "bin": {
    "discussionbridge-astro": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controlled-creation": {
      "types": "./dist/controlled-creation.d.ts",
      "import": "./dist/controlled-creation.js"
    },
    "./web-url": {
      "types": "./dist/web-url.d.ts",
      "import": "./dist/web-url.js"
    },
    "./bridge-record": {
      "types": "./dist/bridge-record.d.ts",
      "import": "./dist/bridge-record.js"
    },
    "./native-publication": {
      "types": "./dist/native-publication.d.ts",
      "import": "./dist/native-publication.js"
    },
    "./operational-state": {
      "types": "./dist/operational-state.d.ts",
      "import": "./dist/operational-state.js"
    },
    "./DiscourseDiscussion.astro": "./src/components/DiscourseDiscussion.astro",
    "./DiscourseReplies.astro": "./src/components/DiscourseReplies.astro",
    "./Discussion.astro": "./src/components/Discussion.astro",
    "./DiscussionCredit.astro": "./src/components/DiscussionCredit.astro",
    "./FromDiscourse.astro": "./src/components/FromDiscourse.astro"
  },
  "files": [
    "dist",
    "src/components",
    "src/assets",
    "README.md",
    "src/simple-live.ts",
    "src/virtual.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:attribution": "node ../../scripts/check-package-attribution.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:inspect": "npm pack --dry-run"
  },
  "keywords": [
    "astro",
    "discussion",
    "discourse",
    "comments",
    "starlight",
    "astro-integration"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.35.0",
    "astro": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.7",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/sanitize-html": "^2.16.0",
    "astro": "^7.2.4",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight": {
      "optional": true
    }
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "dompurify": "3.4.14",
    "proper-lockfile": "^4.1.2",
    "sanitize-html": "2.17.7",
    "yaml": "^2.9.0"
  }
}
