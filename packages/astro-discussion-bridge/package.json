{
  "name": "astro-discussion-bridge",
  "version": "0.1.0-alpha.20260824.3",
  "description": "Controlled Astro-to-DiscussionBridge companion creation with mapped comments-only fullInteractive presentation.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiscussionBridge/astro-discussion-bridge.git",
    "directory": "packages/astro-discussion-bridge"
  },
  "bugs": {
    "url": "https://github.com/DiscussionBridge/astro-discussion-bridge/issues"
  },
  "homepage": "https://github.com/DiscussionBridge/astro-discussion-bridge#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controlled-creation": {
      "types": "./dist/controlled-creation.d.ts",
      "import": "./dist/controlled-creation.js"
    },
    "./web-url": {
      "types": "./dist/web-url.d.ts",
      "import": "./dist/web-url.js"
    },
    "./DiscourseDiscussion.astro": "./src/components/DiscourseDiscussion.astro",
    "./Discussion.astro": "./src/components/Discussion.astro",
    "./DiscussionCredit.astro": "./src/components/DiscussionCredit.astro"
  },
  "files": [
    "dist",
    "src/components",
    "README.md",
    "src/virtual.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:attribution": "node ../../scripts/check-package-attribution.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:inspect": "npm pack --dry-run"
  },
  "keywords": [
    "astro",
    "discussion",
    "discourse",
    "comments",
    "starlight",
    "astro-integration"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.35.0",
    "astro": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.7",
    "@types/node": "^22.0.0",
    "astro": "^7.2.4",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
