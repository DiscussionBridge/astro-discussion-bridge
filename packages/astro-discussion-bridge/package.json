{
  "name": "astro-discussion-bridge",
  "version": "0.1.0",
  "description": "Astro integration toolkit for bridging pages to hosted discussions, starting with Discourse.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiscussionBridge/astro-discussion-bridge.git",
    "directory": "packages/astro-discussion-bridge"
  },
  "bugs": {
    "url": "https://github.com/DiscussionBridge/astro-discussion-bridge/issues"
  },
  "homepage": "https://github.com/DiscussionBridge/astro-discussion-bridge#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "astro-discussion-bridge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/discourse/client.d.ts",
      "import": "./dist/discourse/client.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js"
    },
    "./DiscourseComments.astro": "./src/components/DiscourseComments.astro",
    "./DiscourseReplies.astro": "./src/components/DiscourseReplies.astro",
    "./DiscourseDiscussion.astro": "./src/components/DiscourseDiscussion.astro",
    "./Discussion.astro": "./src/components/Discussion.astro"
  },
  "files": [
    "dist",
    "src/components",
    "README.md",
    "TODO.md",
    "src/virtual.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "sync": "astro-discussion-bridge sync",
    "publish-new": "astro-discussion-bridge publish-new",
    "sync-existing": "astro-discussion-bridge sync-existing",
    "publish-and-sync": "astro-discussion-bridge publish-and-sync"
  },
  "keywords": [
    "astro",
    "discussion",
    "discourse",
    "comments",
    "starlight",
    "astro-integration"
  ],
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0",
    "@astrojs/starlight": ">=0.35.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.2",
    "astro": "^7.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "@types/node": "^22.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight": {
      "optional": true
    }
  }
}
