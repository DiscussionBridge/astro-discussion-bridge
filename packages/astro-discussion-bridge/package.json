{
  "name": "astro-discussion-bridge",
  "version": "0.4.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Unpublished V4 development integration for native Astro source, CMS static publication and Core presentation.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "discussionbridge-astro": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./web-url": { "types": "./dist/web-url.d.ts", "import": "./dist/web-url.js" },
    "./simple-live": { "types": "./dist/simple-live.d.ts", "import": "./dist/simple-live.js" },
    "./controlled-creation": { "types": "./dist/controlled-creation.d.ts", "import": "./dist/controlled-creation.js" },
    "./operational-state": { "types": "./dist/operational-state.d.ts", "import": "./dist/operational-state.js" },
    "./Discussion.astro": "./src/components/Discussion.astro",
    "./DiscourseReplies.astro": "./src/components/DiscourseReplies.astro",
    "./DiscourseDiscussion.astro": "./src/components/DiscourseDiscussion.astro",
    "./DiscussionCredit.astro": "./src/components/DiscussionCredit.astro",
    "./RichContent.astro": "./src/components/RichContent.astro"
  },
  "files": ["dist", "src/components", "src/assets", "src/private", "src/comments-mode.ts", "src/forum-name.ts", "src/web-url.ts", "src/topic-identity.ts", "docs", "scripts/verify-thousand-pages.mjs", "scripts/qualification-lib.mjs"],
  "scripts": { "build": "tsc -p tsconfig.json", "build:browser": "node scripts/build-rich-content.mjs", "test": "node scripts/run-tests.mjs", "test:package": "node scripts/run-tests.mjs cms-package.test.mjs", "verify:thousand-pages": "node scripts/verify-thousand-pages.mjs" },
  "dependencies": { "@astrojs/markdown-remark": "7.2.4", "dompurify": "3.4.17", "proper-lockfile": "^4.1.2", "sanitize-html": "2.18.1", "yaml": "^2.9.0" },
  "peerDependencies": { "astro": "^6.0.0 || ^7.0.0", "@astrojs/starlight": ">=0.35.0" },
  "peerDependenciesMeta": { "@astrojs/starlight": { "optional": true } },
  "devDependencies": { "astro": "7.2.4", "@astrojs/starlight": "0.41.7", "typescript": "5.9.3", "@types/node": "^22.0.0", "@types/proper-lockfile": "^4.1.4", "@types/sanitize-html": "^2.16.0", "esbuild": "0.28.1", "mermaid": "11.17.2", "katex": "0.18.2", "playwright-core": "1.62.1" },
  "overrides": { "dompurify": "$dompurify", "katex": "$katex" }
}
