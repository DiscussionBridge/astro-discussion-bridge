---
import Discussion from "astro-discussion-bridge/Discussion.astro";
import DiscussionRelations from "astro-discussion-bridge/DiscussionRelations.astro";
import DiscussionSource from "astro-discussion-bridge/DiscussionSource.astro";

interface Props {
  commentsDisplay?: "simple" | "full" | "fullInteractive";
  description: string;
  embedUrl?: string;
  frontmatter?: Record<string, unknown>;
  pubDate: Date;
  tags?: string[];
  title: string;
  topicId?: number | string;
  topicUrl?: string;
}

const formattedDate = new Intl.DateTimeFormat("en", {
  dateStyle: "long",
  timeZone: "UTC",
}).format(Astro.props.pubDate);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Astro.props.title} | DiscussionBridge for Astro Demo</title>
    <meta name="description" content={Astro.props.description} />
  </head>
  <body>
    <header class="site-header">
      <a href="/">DiscussionBridge for Astro Demo</a>
      <nav aria-label="Primary">
        <a href="/blog/core-astro-bridge/">Demo article</a>
      </nav>
    </header>
    <main>
      <p class="eyebrow">Plain Astro</p>
      <h1>{Astro.props.title}</h1>
      <p class="description">{Astro.props.description}</p>
      <div class="meta">
        <time datetime={Astro.props.pubDate.toISOString()}>{formattedDate}</time>
        {Astro.props.tags?.length ? (
          <ul aria-label="Tags">
            {Astro.props.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        ) : null}
      </div>
      <article>
        <DiscussionSource frontmatter={Astro.props.frontmatter} />
        <slot />
        <DiscussionRelations frontmatter={Astro.props.frontmatter} />
      </article>
      <Discussion
        display={Astro.props.commentsDisplay}
        embedUrl={Astro.props.embedUrl}
        heading="Discussion"
        topicId={Astro.props.topicId}
        topicUrl={Astro.props.topicUrl}
      />
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --sl-color-gray-5: #d9d6cf;
    --sl-text-h3: 1.35rem;
    --sl-text-sm: 0.95rem;
  }

  body {
    margin: 0;
    background: #fbfaf7;
    color: #232421;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.65;
  }

  a {
    color: #245f73;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem clamp(1rem, 4vw, 3rem);
    border-block-end: 1px solid #d9d6cf;
    background: #fff;
  }

  .site-header > a {
    color: #232421;
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  nav a {
    text-decoration: none;
  }

  main {
    width: min(760px, calc(100% - 2rem));
    margin: 0 auto;
    padding-block: 4rem;
  }

  .eyebrow,
  .meta {
    color: #62665d;
    font-size: 0.95rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.05;
  }

  .description {
    margin-block: 1rem 0;
    font-size: 1.25rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin-block-start: 1rem;
  }

  .meta ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .meta li {
    border: 1px solid #d9d6cf;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }

  article {
    margin-block-start: 3rem;
  }

  @media (prefers-color-scheme: dark) {
    body {
      background: #181a1b;
      color: #f1eee8;
    }

    .site-header {
      background: #202324;
      border-block-end-color: #3c4142;
    }

    .site-header > a {
      color: #f1eee8;
    }

    a {
      color: #85c7d8;
    }

    .eyebrow,
    .meta {
      color: #b7b0a4;
    }

    .meta li {
      border-color: #3c4142;
    }
  }
</style>
