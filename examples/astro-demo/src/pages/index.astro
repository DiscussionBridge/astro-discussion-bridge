---
import { getCollection } from "astro:content";
import DiscussionNavigation from "astro-discussion-bridge/DiscussionNavigation.astro";
import type { DiscussionNavigationManifest } from "astro-discussion-bridge";

const posts = await getCollection("blog");
const navigationManifest = {
  version: 1,
  generatedAt: "2026-07-23T00:00:00.000Z",
  discourseUrl: "https://forum.discussionbridge.dev",
  hierarchyTagGroups: [
    { name: "Demo structure", tags: ["guide", "impact"] },
  ],
  lenses: [
    {
      key: "guide",
      label: "Guides",
      categoryId: 6,
      indexTopicId: 36,
      indexSourceUrl: "https://forum.discussionbridge.dev/t/how-to-choose-a-discussion-bridge-source-mode/36",
      nodes: [
        {
          id: "guide-core",
          topicId: 34,
          label: "Core Astro",
          kind: "section",
          sourceUrl: "https://forum.discussionbridge.dev/t/core-astro-discussion-bridge-demo/34",
          url: "https://astro.demo.discussionbridge.dev/blog/core-astro-bridge/",
          sourceTags: ["discussionbridge", "guide"],
          children: [],
        },
      ],
    },
    {
      key: "impact",
      label: "Impact",
      categoryId: 5,
      indexTopicId: 37,
      indexSourceUrl: "https://forum.discussionbridge.dev/t/every-connection-has-a-job/37",
      nodes: [
        {
          id: "impact-core",
          topicId: 37,
          label: "Community continuity",
          kind: "section",
          sourceUrl: "https://forum.discussionbridge.dev/t/every-connection-has-a-job/37",
          sourceTags: ["discussionbridge", "impact"],
          children: [],
        },
      ],
    },
  ],
} satisfies DiscussionNavigationManifest;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Astro Discussion Bridge Demo</title>
    <meta name="description" content="Plain Astro demo for Discussion Bridge." />
  </head>
  <body>
    <main>
      <p>Plain Astro</p>
      <h1>Astro Discussion Bridge Demo</h1>
      <p>
        A small non-Starlight Astro site proving Discussion Bridge can live in a regular Astro
        layout and content collection.
      </p>
      <ul>
        {posts.map((post) => <li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>)}
      </ul>
      <h2>Progressive content navigation</h2>
      <p>
        The same manifest can drive plain Astro navigation or a Starlight sidebar without
        treating source tags as public presentation.
      </p>
      <DiscussionNavigation manifest={navigationManifest} />
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #fbfaf7;
    color: #232421;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.65;
  }

  main {
    width: min(760px, calc(100% - 2rem));
    margin: 0 auto;
    padding-block: 5rem;
  }

  p:first-child {
    color: #62665d;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.05;
  }

  a {
    color: #245f73;
  }
</style>
