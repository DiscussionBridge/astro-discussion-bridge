---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const releases = (await getCollection("releases")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<StarlightPage
  frontmatter={{
    title: "Release Lane",
    description: "Starlog-style release notes mapped to a dedicated DiscussionBridge content lane.",
    editUrl: false,
  }}
>
  <p>Starlog-style release notes mapped to a dedicated DiscussionBridge content lane.</p>
  <ul>
    {releases.map((entry) => (
      <li>
        <a href={`/releases/${entry.id}/`}>{entry.data.title}</a>
        <span>v{entry.data.versionNumber}</span>
      </li>
    ))}
  </ul>
</StarlightPage>

<style>
  li { margin-block: 0.75rem; }
  span { color: var(--sl-color-gray-3); margin-inline-start: 0.5rem; }
</style>
