---
import { getCollection, render } from "astro:content";
import LaneLayout from "../../layouts/LaneLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("comments");
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<LaneLayout
  laneLabel="Comments Mode"
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  commentsDisplay={entry.data.discussionCommentsDisplay}
  embedUrl={entry.data.discussionEmbedUrl}
  topicId={entry.data.discourseTopicId}
  topicUrl={entry.data.discourseTopicUrl}
>
  <Content />
</LaneLayout>
