---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const posts = (await getCollection("news")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<StarlightPage
  frontmatter={{
    title: "News Lane",
    description: "Announcements mapped to a news discussion lane.",
    editUrl: false,
  }}
>
  <p>Announcements mapped to a news discussion lane.</p>
  <ul>
    {posts.map((entry) => (
      <li><a href={`/news/${entry.id}/`}>{entry.data.title}</a></li>
    ))}
  </ul>
</StarlightPage>

<style>
  li { margin-block: 0.75rem; }
</style>
