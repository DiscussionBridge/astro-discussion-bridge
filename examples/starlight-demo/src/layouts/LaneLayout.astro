---
import Discussion from "astro-discussion-bridge/Discussion.astro";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

interface Props {
  commentsDisplay?: "simple" | "full" | "fullInteractive";
  date: Date;
  description: string;
  embedUrl?: string;
  laneLabel: string;
  title: string;
  topicId?: number | string;
  topicUrl?: string;
}

const formattedDate = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
}).format(Astro.props.date);
---

<StarlightPage
  frontmatter={{
    title: Astro.props.title,
    description: Astro.props.description,
    editUrl: false,
  }}
>
  <p class="lane">{Astro.props.laneLabel}</p>
  <p class="description">{Astro.props.description}</p>
  <p class="date">{formattedDate}</p>
  <article>
    <slot />
  </article>
  <Discussion
    display={Astro.props.commentsDisplay}
    embedUrl={Astro.props.embedUrl}
    heading="Discussion"
    topicId={Astro.props.topicId}
    topicUrl={Astro.props.topicUrl}
  />
</StarlightPage>

<style>
  .lane,
  .date {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .lane {
    margin-block-start: 0;
    font-weight: 700;
    text-transform: uppercase;
  }

  .description {
    font-size: var(--sl-text-lg);
  }

  article {
    margin-block-start: 3rem;
  }
</style>
